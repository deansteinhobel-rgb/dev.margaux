# Copy to .env.local for local work. NEVER commit real values.
# Rule: anything prefixed NEXT_PUBLIC_ is shipped to the browser. Only public, non-secret
# values may use that prefix. Everything else is server-only.

# --- Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SERVER ONLY: bypasses RLS. Never import in client code.)
SUPABASE_SECRET_KEY=

# --- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "development" | "dev" (dev.margaux) | "production" (margaux). Drives noindex + feature flags.
MARGAUX_ENV=development

# --- Third-party APIs (server only; add per module as needed)
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# --- Developer tooling (local shell env, not app runtime). Used by .mcp.json.
CONTEXT7_API_KEY=
TWENTY_FIRST_API_KEY=
